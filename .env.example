# Host port exposed by Docker Compose
APP_PORT=8000

# Published image and release tag. Use a numbered release for reproducible installs.
IMAGE_NAME=ghcr.io/rinsing4852/thinking-board
APP_VERSION=latest

# Match these to the owner of ./data on Unraid/Dockge when needed
PUID=1000
PGID=1000

# Local Stockfish settings
STOCKFISH_DEPTH=14
STOCKFISH_MULTIPV=3
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128
ACCEPTABLE_TOLERANCE_CP=40
MEANINGFUL_LOSS_CP=150

# Required for Lichess Explorer/coverage; public game sync works without it.
LICHESS_API_TOKEN=
